generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== USUARIOS ====================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String?
  phone     String?
  dni       String?
  direccion String?
  piso     String?
  cp        String?
  provincia String?
  ciudad   String?
  role      Role     @default(CLIENT)
  avatar    String?
  location  String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders          Order[]
  adminSales      Order[]         @relation("AdminSales")
  quotes          Quote[]
  sales           Sale[]
  repairs         Repair[]
  guarantees      Guarantee[]
  conversations   Conversation[]
  adminConversations Conversation[] @relation("AdminConversations")
  wallet          Wallet?
  favorites       Favorite[]
  accounts        Account[]
  sessions        Session[]
  arrepentimientos      Arrepentimiento[]
  sentMessages          Message[]
  createdInventoryItems InventoryItem[]    @relation("CreatedBy")
  soldInventoryItems    InventoryItem[]    @relation("SoldBy")
  redeemedGiftCards     GiftCard[]
  coupons               Coupon[]
}

enum Role {
  CLIENT
  ADMIN
}

// ==================== PRODUCTOS ====================
model Product {
  id          String    @id @default(cuid())
  name        String
  ico         String
  imageUrl    String?
  images      String[]
  brand       String
  sub         String?
  description String?
  condition   String
  price       Int
  cost        Int
  battery     Int?
  storage     String?
  ram         String?
  processor   String?
  stock       Int
  reserved    Int       @default(0)
  score       Int?
  color       String?
  screen      Float?
  type        String
  imei        String?
  sold        Int       @default(0)
  
  isOffer     Boolean   @default(false)
  discount   Int       @default(0)
  offerStart DateTime?
  offerEnd   DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  slug       String?

  modelGroup String?

  supplierId  String?
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  orderItems  OrderItem[]
  preOrders   PreOrder[]
  favorites   Favorite[]
  inventoryItems InventoryItem[]
}

// ==================== LOG DE PRODUCTOS (Excel export) ====================
model ProductLog {
  id        String   @id @default(cuid())
  productId String?
  name      String
  brand     String
  price     Int
  cost      Int      @default(0)
  stock     Int
  discount  Int      @default(0)
  condition String
  type      String
  color     String?
  storage   String?
  ram       String?
  battery   Int?
  imei      String?
  source    String   // "manual" | "inventory" | "duplicate"
  createdAt DateTime @default(now())
}

// ==================== INVENTARIO FÍSICO ====================
enum InventoryStatus {
  IN_STOCK
  IN_REPAIR
  RESERVED
  ON_HOLD
  SOLD
}

model InventoryItem {
  id              String          @id @default(cuid())
  code            String          @unique
  imei            String          @unique
  serialNumber    String?

  // Auto-completado por API IMEI
  brand           String
  modelName       String
  storage         String?
  color           String?
  modelNumber     String?
  deviceType      String
  specs           Json?
  imageUrl        String?

  // Datos manuales del negocio
  purchasePrice   Int
  cosmeticCondition String
  functionalCondition String?
  batteryHealth   Int?
  notes           String?
  investor        String?
  targetPrice     Int?

  // Estado
  status          InventoryStatus @default(IN_STOCK)

  // QR
  qrCode          String?
  labelPrinted    Boolean         @default(false)

  // Links
  productId       String?
  product         Product?        @relation(fields: [productId], references: [id])
  supplierId      String?
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])

  // Purchase tracking
  purchasedFrom   String?
  purchaseDate    DateTime        @default(now())

  // Sale tracking
  salePrice       Int?
  soldAt          DateTime?
  soldById        String?
  soldBy          User?           @relation("SoldBy", fields: [soldById], references: [id])

  // Creator
  createdById     String
  createdBy       User            @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  history         InventoryHistory[]
}

model InventoryHistory {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  type            String        // CREATED | STATUS_CHANGE | REPAIR | SOLD | LABEL_PRINTED | NOTE
  oldValue        String?
  newValue        String?
  description     String?
  userId          String?

  createdAt       DateTime      @default(now())
}

// ==================== CACHE DE IMEI (TAC) ====================
model TacCache {
  id          String   @id @default(cuid())
  tac         String   @unique          // primeros 8 dígitos del IMEI
  brand       String
  modelName   String
  storage     String?
  color       String?
  modelNumber String?
  deviceType  String   @default("celular")
  imageUrl    String?
  specs       Json?
  hitCount    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== PEDIDOS ====================
model Order {
  id        String      @id @default(cuid())
  code      String      @unique
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  status    OrderStatus @default(PENDING)
  warranty  String?
  cuotas    Int         @default(1)
  payment   String?
  subtotal  Int
  warrantyCost Int      @default(0)
  deliveryCost Int      @default(0)
  total     Int
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Shipping info
  clientName     String?
  clientDni      String?
  clientCuil     String?
  clientEmail    String?
  clientPhone    String?
  clientAddress  String?
  shippingStreet String?
  shippingNumber String?
  shippingFloor  String?
  shippingZip    String?
  shippingCity   String?
  shippingProvince String?
  
  // Mercado Pago
  mpPreferenceId String?
  mpPaymentId    String?
  mpStatus       String?

  // Arrepentimiento
  arrepStatus    String?     // ARREP_OK, ARREP_RECHAZADO
  arrepReason    String?     // Motivo del rechazo
  refundProcessed Boolean    @default(false)
  refundDate     DateTime?
  
  // Tracking
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?

  // Carrier / Envío Pack
  carrier        String?
  carrierService String?
  enviopackId    String?

  // Ventas presenciales
  cashReceived  Int?
  change        Int?
  saleChannel   String          @default("online")
  currency      String          @default("ARS")
  adminId       String?
  admin         User?           @relation("AdminSales", fields: [adminId], references: [id])

  items           OrderItem[]
  arrepentimientos Arrepentimiento[]
  warrantyExtends WarrantyExtend[]
  orderCoupons    OrderCoupon[]
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Producto del catálogo (opcional para ventas presenciales)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  
  // Campos para productos custom
  customName  String?
  customPrice Int?
  
  quantity    Int      @default(1)
  price       Int
}

// ==================== PREEVENTAS ====================
model PreOrder {
  id           String   @id @default(cuid())
  code         String   @unique
  clientName   String
  clientDni    String?
  clientPhone  String?
  clientEmail  String?
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  customName   String?
  customPrice  Int?
  notes        String?
  status       String   @default("PENDING") // PENDING | CONFIRMED | SOLD | CANCELLED
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==================== COTIZACIONES ====================
model Quote {
  id          String      @id @default(cuid())
  code        String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id])

  device      String
  storage     String
  condition   String

  basePrice   Int
  finalPrice  Int
  bonus       Int?

  status      QuoteStatus @default(PENDING)

  envio       String?
  payment     String?

  clientName  String?
  clientDni   String?
  clientPhone String?
  clientCity  String?
  clientCp    String?
  clientProvince String?

  photos      String[]
  dniPhotos   String[]
  extras      String[]

  rejectReason String?

  signature   String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum QuoteStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  COMPLETED
}

// ==================== VENTAS ====================
model Sale {
  id          String    @id @default(cuid())
  code        String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  device      String
  storage     String?
  condition  String?
  imei        String?

  price       Int
  payment     String
  status      SaleStatus @default(PENDING)

  createdAt   DateTime  @default(now())
}

enum SaleStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

// ==================== REPARACIONES ====================
model Repair {
  id          String       @id @default(cuid())
  code        String       @unique
  userId      String
  user        User         @relation(fields: [userId], references: [id])

  device      String
  issue       String
  serviceId   String?
  service     RepairService? @relation(fields: [serviceId], references: [id])

  price       Int?
  status      RepairStatus @default(PENDING)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum RepairStatus {
  PENDING
  DIAGNOSIS
  APPROVED
  IN_PROGRESS
  COMPLETED
  DELIVERED
}

model RepairService {
  id          String    @id @default(cuid())
  name        String
  ico         String
  description String?
  price       Int
  category    String?

  repairs     Repair[]
}

// ==================== GARANTÍAS ====================
model Guarantee {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])

  product     String
  type        String
  price       Int?

  startsAt    DateTime @default(now())
  expiresAt   DateTime
  status      GuaranteeStatus @default(ACTIVE)

  createdAt   DateTime @default(now())
}

enum GuaranteeStatus {
  ACTIVE
  EXPIRED
  USED
  CANCELLED
}

// ==================== PROVEEDORES ====================
model Supplier {
  id        String    @id @default(cuid())
  name      String
  type      String
  phone     String?
  email     String?
  notes     String?
  total     Int       @default(0)

  products        Product[]
  inventoryItems  InventoryItem[]
  createdAt       DateTime @default(now())
}

// ==================== CONVERSACIONES ====================
model Conversation {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])

  type      ConvType
  subject   String?
  status    ConvStatus @default(OPEN)
  adminId   String?
  admin     User?      @relation("AdminConversations", fields: [adminId], references: [id])
  unread    Int        @default(0)
  unreadByUser  Int    @default(0)
  unreadByAdmin Int    @default(0)
  lastMsgAt DateTime?
  closedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  notifications Notification[]
}

enum ConvType {
  COMPRA
  COTIZACION
  SERVICIO
  REPARACION
  GENERIC
}

enum ConvStatus {
  OPEN
  CLOSED
  ARCHIVED
}

// ==================== MENSAJES ====================
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  from           String
  fromUserId     String?
  fromUser       User?        @relation(fields: [fromUserId], references: [id])
  text           String?
  imageUrl       String?
  imageCaption   String?
  status         MsgStatus    @default(SENT)

  readAt         DateTime?
  createdAt      DateTime     @default(now())

  notifications  Notification[]
}

enum MsgStatus {
  SENT
  DELIVERED
  READ
}

// ==================== WALLET ====================
model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])

  balance     Int      @default(0)
  totalEarned Int      @default(0)
  totalSpent  Int      @default(0)
  version     Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id            String          @id @default(cuid())
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          TransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  referenceId   String?
  description   String?
  createdAt     DateTime        @default(now())

  giftCard  GiftCard?

  @@index([walletId, createdAt])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  GIFT_CARD_REDEEM
  ADMIN_ADJUST
}

// ==================== COUPONS ====================
enum CouponStatus {
  ACTIVE
  USED
  EXPIRED
}

model Coupon {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  code            String       @unique
  originalAmount  Int
  remainingAmount Int
  status          CouponStatus @default(ACTIVE)
  source          String?      // 'giftcard', 'sell', 'admin'
  sourceId        String?      // giftCardId if source='giftcard'
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  usedAt          DateTime?

  orderCoupons OrderCoupon[]

  @@index([userId])
  @@index([code])
  @@index([status])
}

model OrderCoupon {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  couponId    String
  coupon      Coupon  @relation(fields: [couponId], references: [id])
  amountUsed Int
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([couponId])
}

model GiftCard {
  id               String        @id @default(cuid())
  code             String        @unique
  originalAmount   Int
  remainingAmount  Int
  status           GiftCardStatus @default(ACTIVE)
  buyerEmail       String?
  recipientEmail   String?
  message          String?
  mpPreferenceId   String?
  mpPaymentId      String?
  mpStatus         String?
  expiresAt        DateTime?
  purchasedAt      DateTime      @default(now())
  redeemedAt       DateTime?
  redeemedByUserId String?
  redeemedBy       User?         @relation(fields: [redeemedByUserId], references: [id])
  transactionId    String?       @unique
  transaction      WalletTransaction? @relation(fields: [transactionId], references: [id])
  version          Int           @default(0)

  @@index([code])
  @@index([status])
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

// ==================== FAVORITOS ====================
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ==================== NOTIFICACIONES ====================
model Notification {
  id        String   @id @default(cuid())
  userId    String?
  
  type      NotifType
  title     String
  text      String
  read      Boolean  @default(false)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id])

  createdAt DateTime @default(now())
}

enum NotifType {
  OFFER
  LOYALTY
  ORDER
  PROMO
  MESSAGE
}

// ==================== ACCESORIOS ====================
model Accessory {
  id               String   @id @default(cuid())
  name             String
  ico              String?  
  description      String?
  category         String
  price            Int
  compareAtPrice   Int?     
  stock            Int      @default(0)
  imageUrl         String?  
  images           String[] @default([])
  brand            String?  
  color            String?  
  compatibleModels String?  
  isActive         Boolean  @default(true)
  discount         Int?     
  isOffer          Boolean  @default(false)
  offerStart       DateTime?
  offerEnd         DateTime?
  createdAt        DateTime @default(now())
}

// ==================== NEXT.AUTH ====================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== VERIFICACION EMAIL ====================
model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, code])
}

// ==================== RESET PASSWORD ====================
model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==================== ARREPENTIMIENTO (Ley 24.240 - Resolucion 424/2020) ====================
model Arrepentimiento {
  id          String            @id @default(cuid())
  orderId     String
  order       Order            @relation(fields: [orderId], references: [id])
  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
  
  email       String
  telefono    String?
  motivo      String?
  estado      ArrepEstado      @default(PENDIENTE)
  tramite     String?
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum ArrepEstado {
  PENDIENTE
  APROBADO
  RECHAZADO
  COMPLETADO
}

// ==================== RATE LIMITING (DB-based, survives restarts) ====================
model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// ==================== EXTENSIÓN DE GARANTÍA ====================
model WarrantyExtend {
  id        String              @id @default(cuid())
  orderId   String
  order     Order               @relation(fields: [orderId], references: [id])
  imei      String
  plan      String              // "12m" or "24m"
  months    Int
  price     Int
  status    WarrantyExtendStatus @default(PENDING_PAYMENT)
  startDate DateTime            @default(now())
  endDate   DateTime
  createdAt DateTime            @default(now())

  mpPreferenceId String?
  mpPaymentId    String?
  mpStatus       String?
}

enum WarrantyExtendStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}
