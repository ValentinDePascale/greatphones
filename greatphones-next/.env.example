# ==================== DATABASE ====================
DATABASE_URL="postgresql://user:pass@host/db"
# Neon: postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/db?sslmode=require
# Local: postgresql://postgres:postgres@localhost:5432/greatphones

# DIRECT_URL is optional — Neon uses it for direct (non-pooled) connections
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ==================== NEXT.JS ====================
NEXTAUTH_URL="https://greatphones.com.ar"  # or http://localhost:3000 for dev
NEXTAUTH_SECRET=""  # openssl rand -base64 32

# ==================== MERCADO PAGO ====================
MP_ACCESS_TOKEN="TEST-xxxxx"  # production: APP_USR-xxxxx
MP_WEBHOOK_SECRET=""  # set in MercadoPago webhook dashboard too

# ==================== GOOGLE OAUTH ====================
GOOGLE_CLIENT_ID=""  # Google Cloud Console → OAuth 2.0 Client ID
GOOGLE_CLIENT_SECRET=""  # Google Cloud Console → OAuth 2.0 Client Secret

# ==================== EMAIL (Nodemailer) ====================
EMAIL_USER="tucorreo@gmail.com"
EMAIL_PASS=""  # Gmail app password (activá 2FA → Contraseñas de aplicación)

# ==================== CLOUDINARY ====================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# ==================== SHIPPING ====================
# EnvioPack
ENVIOPACK_API_KEY=""   # optional — cotiza con estimados si no está configurado
ENVIOPACK_SECRET_KEY="" # optional — crear envío real requiere ambas keys

# Andreani
ANDREANI_API_URL="https://api.andreani.com"
ANDREANI_CONTRATO=""  # optional
ANDREANI_CUIT=""      # optional

# ==================== RESEND (alternative email) ====================
RESEND_API_KEY=""

# ==================== OPTIONAL ====================
# OPENAI_API_KEY=""       # AI-powered conversations
# CLOUDFLARE_ACCOUNT_ID=""  # R2 or Image optimization
# CLOUDFLARE_ACCESS_KEY_ID=""
# CLOUDFLARE_SECRET_ACCESS_KEY=""
